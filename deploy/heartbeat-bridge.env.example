# Keep actual values only in /opt/sub2api/.env. Do not commit secrets.
HEARTBEAT_SUB2API_ADMIN_AUTH_HEADER=x-api-key
HEARTBEAT_SUB2API_ADMIN_TOKEN=
HEARTBEAT_ALLOWED_SESSION_KEY=
HEARTBEAT_BRIDGE_BUILD_CONTEXT=../heartbeat-bridge
HEARTBEAT_VAULT_URL=http://47.97.207.205:44444/api/hb/keys
# The documented vault is plain HTTP. It must be an explicit deployment decision.
HEARTBEAT_ALLOW_INSECURE_VAULT=false
HEARTBEAT_DEEPSEEK_GROUP_ID=12
HEARTBEAT_PROXY_GROUP_ID=1
HEARTBEAT_WORKER_COUNT=2
HEARTBEAT_PROXY_PROBE_WORKERS=10
HEARTBEAT_PROXY_PROBE_TIMEOUT=5s
HEARTBEAT_PROVISION_TIMEOUT=20m
HEARTBEAT_POLL_INTERVAL=1s
HEARTBEAT_MAX_ATTEMPTS=5
HEARTBEAT_PROXY_SWEEP_TTL=5m
